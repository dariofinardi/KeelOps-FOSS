# Percorso del database di KeelOps (letto in SOLA lettura)
KEELOPS_DB=/srv/keelops/data/app.db
# Indirizzo pubblico di KeelOps, per i link nei risultati e la pagina di accesso
KEELOPS_URL=https://crm.example.com
# L'indirizzo PUBBLICO di questo plugin dietro nginx: issuer OAuth e risorsa MCP.
# Claude/ChatGPT/Mistral pretendono HTTPS raggiungibile da internet.
MCP_PUBLIC_URL=https://crm.example.com/plugins/mcp
# Porta locale (nginx: location /plugins/mcp/ -> proxy_pass http://127.0.0.1:5320/)
PORT=5320
# Nome del cookie di sessione di KeelOps (kancrm_session_dev in sviluppo)
SESSION_COOKIE=kancrm_session
