# Percorso del database di KeelOps (letto in SOLA lettura)
KEELOPS_DB=/srv/keelops/data/app.db
# Indirizzo pubblico di KeelOps, per i link "Apri in KeelOps" e il login
KEELOPS_URL=https://crm.example.com
# Ollama per gli embedding dei temi (vuoto = ripiego tf-idf senza modelli)
OLLAMA_URL=http://127.0.0.1:11435
# Porta del plugin (nginx: location /plugins/mappa/ -> proxy_pass a questa porta)
PORT=5310
# Nome del cookie di sessione di KeelOps (kancrm_session_dev in sviluppo)
SESSION_COOKIE=kancrm_session
