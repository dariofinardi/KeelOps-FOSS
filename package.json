{
  "name": "kancrm",
  "private": true,
  "type": "module",
  "version": "0.12.67",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --parallel -r --if-present dev",
    "build": "pnpm --filter @kancrm/web build && pnpm --filter @kancrm/plugin-personale-ui build",
    "db:migrate": "pnpm --filter @kancrm/server db:migrate",
    "db:seed": "pnpm --filter @kancrm/server db:seed",
    "db:studio": "pnpm --filter @kancrm/server db:studio",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "overrides": {
      "mariadb": "~3.4.6",
      "uuid": "^11.1.1",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
